#############################
### PARAMETER DEFINITIONS ###
#############################

# Reference particle momentum:
param refP=200.0

# Beam initial conditions:
param refX=0.0
param refY=0.0
param refXp=0.0
param refYp=0.0

# Solenoid geometry:
param solinner=400.0
param solthick=100.0
param sollength=100.0

# Solenoid field:
param solcurrent=100.0
param maxStep=5.0

# Solenoid rotations:
param rot=X0.0,Z0.0

# Note: rotations are applied left-to-right and given in degrees. 
#	Provide comma-separated list with axis about with to rotate followed by angle of rotation.
#	For example, 'X1.0,Z90.0' rotates about x 1 degree then z 90 degrees.

######################
### INITIALIZATION ###
######################

# Disable decay/stochastics:
physics QGSP_BIC doStochastics=0 

# Reference particle:
reference particle=mu+ \
	beamX=0.0 beamY=0.0 beamZ=0.0 \
	beamXp=0.0 beamYp=0.0 \
	referenceMomentum=$refP
trace format=ascii nTrace=10 oneNTuple=1

# Beam:
beam gaussian particle=mu+ nEvents=1 beamX=1.5 beamY=0.0 beamZ=-3000 beamXp=$refXp  beamYp=$refYp \
     sigmaX=0.0 sigmaY=0. sigmaXp=0. sigmaYp=0. meanMomentum=$refP sigmaP=0.0 meanT=0.0 sigmaT=0.0

# Kill secondaries:
trackcuts killSecondaries=1

############################
### GEOMETRY DEFINITIONS ###
############################

# Solenoid:
coil coil innerRadius=$solinner outerRadius=$solinner+$solthick length=$sollength maxR=5000 maxZ=10000.0
solenoid coil coilName=coil current=$solcurrent

# Detector:
virtualdetector det radius=300 length=0.001 color='' format=ascii

#########################
### ELEMENT PLACEMENT ###
#########################

place det x=0 y=0 z=0
place coil x=0 y=0 z=0 rotation=$rot

####################
### FIELD OUTPUT ###
####################

param rangeTrans=$solinner+$solthick+20
param rangeLong=$sollength/2+50

fieldntuple fieldmap format=ascii x=-$rangeTrans,$rangeTrans,10 y=-$rangeTrans,$rangeTrans,10 z=-$rangeLong,$rangeLong,10