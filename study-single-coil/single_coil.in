#################
### CONSTANTS ###
#################

# Reference particle momentum:
param refP=200.0

# Beam initial conditions:
param refXp=0.0
param refYp=0.0

######################
### INITIALIZATION ###
######################

randomseed time

# Disable decay/stochastics:
physics QGSP_BIC doStochastics=0 

# Reference particle:
reference particle=mu+ \
	beamX=0 \
	beamY=0 \
	beamZ=0.0 \
	beamXp=0 beamYp=0 \
	referenceMomentum=$refP
particlecolor reference=1,1,1
trace format=ascii nTrace=10 oneNTuple=1

# Beam:
beam gaussian particle=mu+ nEvents=1 beamX=1.5 beamY=0.0 beamZ=-3000 beamXp=$refXp  beamYp=$refYp \
     sigmaX=0.0 sigmaY=0. sigmaXp=0. sigmaYp=0. meanMomentum=$refP sigmaP=0.0 meanT=0.0 sigmaT=0.0

trackcuts killSecondaries=1

############################
### GEOMETRY DEFINITIONS ###
############################

# Parameters:
param solinner=400.0
param solthick=100.0
param sollength=100.0
param period=1000.0
param solcurrent=100.0
param maxStep=5.0
param pitch=0.0

# Solenoid:
coil coil innerRadius=$solinner outerRadius=$solinner+$solthick length=$sollength maxR=5000 maxZ=10000.0
solenoid coil coilName=coil current=$solcurrent

# Detector:
virtualdetector det radius=300 length=0.001 color='' format=ascii

################################
### ELEMENT PLACING SEQUENCE ###
################################

do i 0 0

  place det x=0 z=$period*$i y=0
  place coil x=0 z=$period*$i+$period/2  y=0 rotation=X$pitch
  
enddo